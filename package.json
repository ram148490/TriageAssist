{
  "name": "triageassist",
  "private": true,
  "version": "1.0.0",
  "description": "AI-assisted symptom triage queue for Meridian Urgent Care front-desk staff.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --define:process.env.NODE_ENV=\\\"production\\\" --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "migrate": "tsx server/migrate.ts",
    "create-user": "tsx server/create-user.ts",
    "test": "tsx tests/test-logic.ts && tsx tests/test-classifier.ts && tsx tests/test-classifier-http.ts && tsx tests/test-security-unit.ts",
    "test:api": "tsx tests/test-api-edge.ts",
    "test:failsafe": "tsx tests/test-failsafe-e2e.ts",
    "test:security": "tsx tests/test-security-e2e.ts",
    "test:privacy": "tsx tests/test-privacy-e2e.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "pg": "^8.13.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
