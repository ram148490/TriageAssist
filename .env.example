# DATABASE_URL: PostgreSQL connection string.
# If you use the included docker-compose.yml as-is, this default works unchanged.
DATABASE_URL="postgresql://triageassist:triageassist@localhost:5432/triageassist"

# GEMINI_API_KEY: Required for AI symptom classification (Google Gemini structured output).
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# CONFIDENCE_THRESHOLD: Classifications with confidence BELOW this value (0-1) are
# flagged for mandatory human review and are never auto-routed. Default 0.7.
CONFIDENCE_THRESHOLD="0.7"

# PORT: Local port for the combined Express + Vite dev server.
PORT="3000"

# HOST: address to bind. Loopback by default; only change it behind a TLS reverse proxy.
# HOST="127.0.0.1"

# Sign-out after this many minutes of inactivity / hours in total.
# SESSION_IDLE_MINUTES="30"
# SESSION_MAX_HOURS="12"

# GEMINI_PAID_TIER_CONFIRMED: patient symptom text is sent to Google. Only set this to "true"
# if the key is on Google's PAID Gemini API terms (the unpaid tier may use content to improve
# Google products). Required for AI classification when NODE_ENV=production.
# GEMINI_PAID_TIER_CONFIRMED="true"

# DATABASE_SSL: set to "true" to require TLS to a database that isn't on this machine.
# DATABASE_SSL="true"
