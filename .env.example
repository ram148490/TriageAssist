# DATABASE_URL: PostgreSQL connection string.
# If you use the included docker-compose.yml as-is, this default works unchanged.
DATABASE_URL="postgresql://triageassist:triageassist@localhost:5432/triageassist"

# GEMINI_API_KEY: Required for AI symptom classification (Google Gemini structured output).
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# CONFIDENCE_THRESHOLD: Classifications with confidence BELOW this value (0-1) are
# flagged for mandatory human review and are never auto-routed. Default 0.7.
CONFIDENCE_THRESHOLD="0.7"

# PORT: Local port for the combined Express + Vite dev server.
PORT="3000"
